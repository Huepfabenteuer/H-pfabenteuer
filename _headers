# Cache-Optimierung für Hüpfabenteuer

# Bilder & Videos - 7 Tage (ausgetauschte Fotos mit gleichem Namen kommen so spätestens nach einer Woche an)
# Schriften - 1 Jahr (ändern sich nie)
/*.jpg
  Cache-Control: public, max-age=604800
/*.jpeg
  Cache-Control: public, max-age=604800
/*.png
  Cache-Control: public, max-age=604800
/*.webp
  Cache-Control: public, max-age=604800
/*.svg
  Cache-Control: public, max-age=604800
/*.gif
  Cache-Control: public, max-age=604800
/*.ico
  Cache-Control: public, max-age=604800
/*.mp4
  Cache-Control: public, max-age=604800
/*.webm
  Cache-Control: public, max-age=604800
/*.woff
  Cache-Control: public, max-age=31536000, immutable
/*.woff2
  Cache-Control: public, max-age=31536000, immutable
/*.ttf
  Cache-Control: public, max-age=31536000, immutable

# CSS & JS - jedes Mal kurz nachfragen, ob es eine neue Fassung gibt
# (die Seiten hängen zusätzlich ?v=Datum an, damit auch Safari sofort aktualisiert)
/*.css
  Cache-Control: public, max-age=0, must-revalidate
/*.js
  Cache-Control: public, max-age=0, must-revalidate

# HTML-Seiten - immer die aktuelle Fassung (Safari hat sonst bis zu 1 Stunde die alte gezeigt)
/
  Cache-Control: public, max-age=0, must-revalidate
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# Sitemap & Robots - 1 Tag
/sitemap.xml
  Cache-Control: public, max-age=86400
/robots.txt
  Cache-Control: public, max-age=86400

# Sicherheits-Header (Bonus: bringt SEO-Bonus)
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Verwaltung: nie zwischenspeichern, nie in Google
/verwaltung.html
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow
  Referrer-Policy: no-referrer
