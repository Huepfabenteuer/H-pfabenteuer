# Netlify _redirects für Hüpfabenteuer
# https://docs.netlify.com/routing/redirects/

# ─────────────────────────────────────────────────────────────
# ROOT-FIX: Inhalt liegt jetzt direkt auf index.html (Root).
# Alte /home.html-URL per 301 auf die Root umleiten, damit die
# bereits aufgebaute Linkkraft & Indexierung an / weitergegeben wird.
# /index.html ebenfalls auf / (verhindert Duplicate-Content).
# ─────────────────────────────────────────────────────────────
/home.html         /                       301!
/index.html        /                       301

# ─────────────────────────────────────────────────────────────
# CLEAN URLS: /alienburg etc. → .html-Version
# Status 301 = permanenter Redirect (sammelt Linkkraft).
# ─────────────────────────────────────────────────────────────
/unsere-angebote   /unsere-angebote.html   301
/alienburg         /alienburg.html         301
/piratenburg       /piratenburg.html       301
/ritterburg        /ritterburg.html        301
/candyburg         /candyburg.html         301
/feuerwehrburg     /feuerwehrburg.html     301
/hochzeitsburg     /hochzeitsburg.html     301
/fotobox           /fotobox.html           301
/zuckerwatte       /zuckerwatte.html       301
/popcorn           /popcorn.html           301
/anfragen          /anfragen.html          301
/kontakt           /kontakt.html           301
/impressum         /impressum.html         301
/datenschutz       /datenschutz.html       301
/agbs              /agbs.html              301
/alienanleitung    /alienanleitung.html    301
/piratenanleitung  /piratenanleitung.html  301
/ritterburganleitung /ritterburganleitung.html 301
/candyburganleitung  /candyburganleitung.html  301

# ─────────────────────────────────────────────────────────────
# DUPLICATE-CONTENT SCHUTZ: alter files/-Ordner blockieren
# Falls Google das schon gecrawlt hat, gehen die zur Hauptversion
# ─────────────────────────────────────────────────────────────
/files/*           /:splat                 301
