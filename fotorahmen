<link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@400;700;800;900&family=Nunito:wght@400;600;700;800&display=swap" rel="stylesheet"/>
<style>
:root{--pink:#ff4fa3;--purple:#a855f7;--sky:#00c2ff;--sun:#FFD600;--dark:#0f0b2e;--shadow:0 8px 32px rgba(0,0,0,.10);}
html{color-scheme:light only;}*{box-sizing:border-box;margin:0;padding:0;}
body{font-family:'Nunito',sans-serif;background:#f0f2f8;color:#0f0b2e;padding-bottom:86px;}
.ph{background:linear-gradient(155deg,#0d0929 0%,#1a0d55 40%,#2a1668 70%,#1e0d4a 100%);padding:24px 18px 60px;position:relative;overflow:hidden;}
.ph-topbar{display:flex;align-items:center;justify-content:space-between;margin-bottom:22px;}
.ph-back{background:rgba(255,255,255,.15);border:1.5px solid rgba(255,255,255,.28);color:white;padding:8px 15px;border-radius:50px;font-family:'Baloo 2',cursive;font-size:13px;font-weight:700;text-decoration:none;}
.ph-title{font-family:'Baloo 2',cursive;font-size:26px;font-weight:900;color:white;margin-bottom:6px;}
.ph-title em{color:var(--sun);font-style:normal;}
.ph-sub{color:rgba(255,255,255,.8);font-size:13px;font-weight:600;}
.wave{position:absolute;bottom:-2px;left:-1px;right:-1px;width:calc(100%+2px);display:block;}
.content{padding:24px 16px;max-width:800px;margin:0 auto;}
.sec-header{border-radius:18px;padding:18px 20px;margin-bottom:20px;}
.sec-header.standard{background:linear-gradient(135deg,#120a38,#1e0f60);border:2px solid rgba(168,85,247,.4);}
.sec-header.premium{background:linear-gradient(135deg,#1c0c00,#3d1f00);border:2px solid rgba(255,185,0,.4);}
.sec-title{font-family:'Baloo 2',cursive;font-size:20px;font-weight:900;color:white;margin-bottom:4px;display:flex;align-items:center;gap:10px;flex-wrap:wrap;}
.sec-badge{font-family:'Baloo 2',cursive;font-size:11px;font-weight:900;padding:3px 10px;border-radius:20px;}
.badge-std{background:linear-gradient(135deg,var(--pink),var(--purple));color:white;}
.badge-prem{background:linear-gradient(135deg,#FFD600,#ff8c00);color:#1c0c00;}
.sec-sub{color:rgba(255,255,255,.85);font-size:12px;font-weight:700;}
.frames-section{display:flex;flex-direction:column;gap:16px;margin-bottom:32px;}
.frame-group{background:white;border-radius:18px;overflow:hidden;box-shadow:var(--shadow);border:1.5px solid rgba(0,0,0,.05);}
.frame-label{font-family:'Baloo 2',cursive;font-size:14px;font-weight:900;color:#0f0b2e;padding:12px 16px 10px;border-bottom:2px solid #f0f0f0;background:#fafafa;}
.frame-pair{display:grid;grid-template-columns:1fr 1fr;}
.frame-item{background:#f9f9f9;}
.frame-item img{width:100%;aspect-ratio:1;object-fit:contain;padding:8px;display:block;}
.frame-pair .frame-item:first-child{border-right:1px solid #f0f0f0;}
.cta-btn{display:flex;align-items:center;justify-content:center;gap:8px;background:linear-gradient(135deg,var(--pink),var(--purple));color:white;padding:16px;border-radius:16px;font-family:'Baloo 2',cursive;font-size:16px;font-weight:800;text-decoration:none;box-shadow:0 6px 20px rgba(255,79,163,.35);margin-bottom:16px;}
.bnav{position:fixed;bottom:0;left:0;right:0;z-index:999;background:rgba(13,9,40,.97);backdrop-filter:blur(20px);border-top:1px solid rgba(255,255,255,.1);display:flex;height:70px;}
.bi{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:3px;text-decoration:none;color:rgba(255,255,255,.5);}
.bi-ic{font-size:21px;}.bi-lb{font-family:'Baloo 2',cursive;font-size:10px;font-weight:700;}
footer{background:var(--dark);padding:26px 20px 18px;text-align:center;}
.fl{font-family:'Baloo 2',cursive;font-size:18px;font-weight:900;color:white;margin-bottom:4px;}
.flinks{display:flex;flex-wrap:wrap;justify-content:center;gap:7px;margin:10px 0;}
.flink{color:rgba(255,255,255,.62);text-decoration:none;font-size:11px;padding:4px 10px;background:rgba(255,255,255,.09);border-radius:20px;}
.fcopy{font-size:11px;color:rgba(255,255,255,.42);margin-top:10px;}
@media(min-width:768px){body{padding-bottom:0;}.bnav{display:none;}}
</style>
</head>
